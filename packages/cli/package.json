{
  "name": "kuclab-hertz",
  "version": "0.15.0",
  "description": "Self-hosted agentní vývojová platforma s WebUI, distribuovaná přes npm.",
  "license": "Apache-2.0",
  "author": "KucLab",
  "type": "module",
  "bin": {
    "hzcli": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/bin.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@kuclab-hertz/server": "workspace:*",
    "prompts": "^2.4.2",
    "kleur": "^4.1.5",
    "zod": "^3.24.0",
    "@kuclab-hertz/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerry256254/Hertz.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
